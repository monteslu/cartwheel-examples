; BikeMesa project settings
game_app = bikemesa

; export presets (tools/cwexport.mjs --project games/bikemesa/assets --preset <name>)
name = "bikemesa"
app = "bikemesa"
export.linux.platform = "linux-x64"
export.windows.platform = "windows-x64"
export.macos.platform = "macos"
export.web.platform = "web"
export.cart.platform = "wasc"
export.android.platform = "android-arm64"
export.android.app_id = "org.cartwheel.bikemesa"
