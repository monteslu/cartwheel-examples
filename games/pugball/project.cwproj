; pugball's release builds: node <host sdk>/tools/cwexport.mjs --project games/pugball --preset <preset>
; (CI packages each from the tree scripts/build.sh made for the platform: --build build/<target>)
name = "pugball"
app = "pugball"
app_id = "org.cartwheel.pugball"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "Pugs with jet packs push one very round, very cross cat into the goal. Play exhibitions from one against one to three a side with players and computer pugs, or win the Pug Cup across five stadiums."
author = "Luis Montes"
