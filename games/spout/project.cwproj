; spout's release builds: node <host sdk>/tools/cwexport.mjs --project games/spout --preset <preset>
; (CI packages each from the tree scripts/build.sh made for the platform: --build build/<target>)
name = "spout"
app = "spout"
title = "Spout"
app_id = "org.cartwheel.spout"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "A papercraft spider climbs five rain spouts through sun, wind, rain and snow. Brace against the waves, jump the slick paper wraps and gather dewdrops on the way to the top."
author = "Luis Montes"
