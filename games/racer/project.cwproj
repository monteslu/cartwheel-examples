; racer's release builds: node <host sdk>/tools/cwexport.mjs --project games/racer --preset <preset>
; (CI packages each from the tree scripts/build.sh made for the platform: --build build/<target>)
; the game's name is still to be decided (GAME_TITLE in game.h)
game_app = racer

name = "racer"
app = "racer"
app_id = "org.cartwheel.racer"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"

# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "An arcade kart racer across eight tracks with loops, corkscrews and jumps. Race, battle in arenas or chase your own ghost, alone or with up to four players in split screen."
author = "Luis Montes"
