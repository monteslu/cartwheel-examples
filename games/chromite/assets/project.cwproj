; chromite project settings
game_app = chromite

; export presets (tools/cwexport.mjs --project games/chromite/assets --preset <name>)
name = "Chromite"
app = "chromite"
export.linux.platform = "linux-x64"
export.windows.platform = "windows-x64"
export.macos.platform = "macos"
export.web.platform = "web"
export.cart.platform = "wasc"
export.android.platform = "android-arm64"
export.android.app_id = "org.cartwheel.chromite"
