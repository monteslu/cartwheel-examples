; BomberDude's release builds: node <host sdk>/tools/cwexport.mjs --project games/bomberdude --preset <preset>
; (CI packages each from the tree scripts/build.sh made for the platform: --build build/<target>)
name = "BomberDude"
app = "bomberdude"
version = "0.1.0"
app_id = "org.cartwheel.bomberdude"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "Four plush critters drop bombs, kick them and chain blasts across eight arenas. Play a quick round against the computer, battle with up to four players, or beat the Adventure stages in order."
author = "Luis Montes"
