; otium project settings
game_app = otium

; export presets (tools/cwexport.mjs --project games/otium/assets --preset <name>)
name = "Otium"
app = "otium"
export.linux.platform = "linux-x64"
export.windows.platform = "windows-x64"
export.macos.platform = "macos"
export.web.platform = "web"
export.cart.platform = "wasc"
export.android.platform = "android-arm64"
export.android.app_id = "org.cartwheel.otium"
